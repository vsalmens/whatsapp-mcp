#!/usr/bin/env bash
# post-receive — deploy hook for a bare repo on the bridge host.
#
#   git push <host> main  →  checkout into the working tree → build → restart launchd services
#
# If the build fails, the working tree is reverted and the services keep running the old binary.
# store/ is git-ignored, so deploys never touch the message database or the device keys.
#
# Install on the bridge host (any location; the working tree defaults to the bare repo's
# path without ".git", e.g. ~/Services/whatsapp-mcp.git -> ~/Services/whatsapp-mcp):
#   git init --bare ~/Services/whatsapp-mcp.git
#   cp deploy/post-receive ~/Services/whatsapp-mcp.git/hooks/ && chmod +x ~/Services/whatsapp-mcp.git/hooks/post-receive
#
# Per-host settings live in the bare repo's config (a push carries no environment):
#   git -C <bare repo> config deploy.work        <dir>     # working tree (default: see above)
#   git -C <bare repo> config deploy.labelPrefix <prefix>  # launchd labels <prefix>.bridge / <prefix>.mcp
#   git -C <bare repo> config deploy.bridgeLabel <label>   # full labels, if they don't follow the prefix
#   git -C <bare repo> config deploy.mcpLabel    <label>
set -uo pipefail
cfg(){ git config --get "deploy.$1" || echo "$2"; }
GIT_ROOT="$(git rev-parse --absolute-git-dir)"
WORK="${WORK:-$(cfg work "${GIT_ROOT%.git}")}"
LABEL_PREFIX="${LABEL_PREFIX:-$(cfg labelPrefix local.whatsapp-mcp)}"
BRIDGE_LABEL="${BRIDGE_LABEL:-$(cfg bridgeLabel "$LABEL_PREFIX.bridge")}"
MCP_LABEL="${MCP_LABEL:-$(cfg mcpLabel "$LABEL_PREFIX.mcp")}"
BRANCH="main"
UIDN="$(id -u)"
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
ZERO="0000000000000000000000000000000000000000"

while read -r old new ref; do
  [[ "$ref" == "refs/heads/$BRANCH" ]] || continue
  echo "→ deploying $(git rev-parse --short "$new") to $WORK"
  mkdir -p "$WORK"
  git --work-tree="$WORK" checkout -f "$BRANCH" || { echo "✗ checkout failed"; exit 1; }

  ok=1
  ( cd "$WORK/whatsapp-bridge" && go build -o whatsapp-bridge.new . ) || ok=0
  if (( ok )); then
    ( cd "$WORK/whatsapp-mcp-server" && uv sync -q && uv run python -m py_compile main.py whatsapp_extras.py ) || ok=0
  fi

  if (( ok )); then
    mv "$WORK/whatsapp-bridge/whatsapp-bridge.new" "$WORK/whatsapp-bridge/whatsapp-bridge"
    restarted=1
    for label in "$BRIDGE_LABEL" "$MCP_LABEL"; do
      launchctl kickstart -k "gui/$UIDN/$label" && echo "✓ restarted $label" || { echo "✗ could not restart $label"; restarted=0; }
    done
    sleep 5
    tail -n 5 "$HOME/Library/Logs/whatsapp-bridge.log" 2>/dev/null | sed 's/^/   log: /'
    if (( restarted )); then
      echo "✓ deployed $(git rev-parse --short "$new")"
    else
      echo "⚠ deployed $(git rev-parse --short "$new"), but services were not restarted (check labels: deploy.labelPrefix)"
      exit 1
    fi
  else
    rm -f "$WORK/whatsapp-bridge/whatsapp-bridge.new"
    echo "✗ build or check failed — services keep running the previous version"
    if [[ "$old" != "$ZERO" ]]; then
      # Reset index + working tree to the old commit (also removes files added by the bad push)
      # and move the branch back, so the bare repo reflects what is actually deployed.
      git --work-tree="$WORK" read-tree -u --reset "$old" \
        && git update-ref "refs/heads/$BRANCH" "$old" "$new" \
        && echo "↩ working tree and $BRANCH reverted to $(git rev-parse --short "$old")"
      # uv sync may already have updated .venv for the failed push; match it to the old code again
      ( cd "$WORK/whatsapp-mcp-server" && uv sync -q ) && echo "↩ Python environment re-synced"
    fi
    exit 1
  fi
done
